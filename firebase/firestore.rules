rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function googleUser() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function admin() {
      return googleUser() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    function teacher() {
      return googleUser() && ((exists(/databases/$(database)/documents/teacherDirectory/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/teacherDirectory/$(request.auth.token.email.lower())).data.status == 'active') || admin());
    }
    function ownsClass(classId) {
      return teacher() && get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
    }
    function rosterMember(classId) {
      let course = get(/databases/$(database)/documents/classes/$(classId)).data;
      return googleUser() && course.archived == false
        && request.auth.token.email.lower() in course.roster;
    }
    function workspaceAdvanced(id) {
      let path = /databases/$(database)/documents/workspaces/$(id);
      return getAfter(path).data.ownerUid == request.auth.uid
        && ((!exists(path) && getAfter(path).data.revision == 1)
          || getAfter(path).data.revision == get(path).data.revision + 1);
    }
    function validMeeting(d, id) {
      return d.keys().hasOnly(['id', 'number', 'startAt', 'endAt', 'state', 'dayStart', 'dayEnd', 'records', 'auditEvents'])
        && d.id == id && d.number is int && d.number > 0
        && d.startAt is string && d.endAt is string
        && d.state in ['upcoming', 'active', 'closed']
        && d.dayStart is timestamp && d.dayEnd is timestamp && d.dayEnd > d.dayStart
        && d.records is map && d.auditEvents is list;
    }
    function correction(d) {
      let old = resource.data;
      let changed = d.records.diff(old.records).affectedKeys();
      let audit = d.auditEvents[d.auditEvents.size() - 1];
      return d.state == 'closed' && changed.size() == 1
        && d.auditEvents.size() == old.auditEvents.size() + 1
        && d.auditEvents.hasAll(old.auditEvents)
        && audit.keys().hasOnly(['id', 'createdAt', 'action', 'reason', 'rollNumber', 'meetingId', 'oldValue', 'newValue'])
        && audit.id is string && audit.id.size() > 0 && audit.createdAt is string
        && audit.action == 'attendance_override'
        && audit.reason is string && audit.reason.matches('.*\\S.*')
        && audit.meetingId == old.id && audit.rollNumber in changed
        && audit.newValue in ['P', 'A']
        && audit.oldValue == old.records[audit.rollNumber].status
        && audit.newValue == d.records[audit.rollNumber].status
        && d.records[audit.rollNumber].source == 'manual'
        && d.records[audit.rollNumber].keys().hasOnly(['status', 'source', 'recordedAt', 'note'])
        && d.records[audit.rollNumber].recordedAt is string
        && d.records[audit.rollNumber].note == audit.reason
        && d.diff(old).affectedKeys().hasOnly(['records', 'auditEvents']);
    }
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // Privileged profiles are provisioned using Admin SDK by the project owner.
      allow list, create, update, delete: if false;
    }
    match /teacherDirectory/{email} {
      function valid(d) {
        return d.keys().hasOnly(['email', 'displayName', 'staffCode', 'department', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
          && d.email == email && d.email is string && d.email.size() <= 254
          && d.email.matches('[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}')
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 160
          && d.staffCode is string && d.staffCode.size() <= 40
          && d.department is string && d.department.size() <= 160
          && d.status in ['active', 'suspended']
          && d.createdAt is timestamp && d.updatedAt == request.time
          && d.createdBy is string && d.updatedBy == request.auth.uid;
      }
      allow get: if admin() || (googleUser() && email == request.auth.token.email.lower());
      allow list: if admin();
      allow create: if admin() && valid(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if admin() && valid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.email == resource.data.email;
      allow delete: if admin();
    }
    match /teacherAudit/{id} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['actorUid', 'email', 'action', 'before', 'after', 'at'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.action in ['create', 'update', 'suspend', 'activate', 'delete']
        && request.resource.data.before is map && request.resource.data.after is map
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /workspaces/{id} {
      allow get: if teacher() && (!exists(/databases/$(database)/documents/workspaces/$(id)) || resource.data.ownerUid == request.auth.uid);
      allow list: if teacher() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if teacher()
        && request.resource.data.keys().hasOnly(['ownerUid', 'revision', 'mutationId', 'data', 'layout', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.revision is int
        && request.resource.data.mutationId is string
        && request.resource.data.data is map && request.resource.data.layout is map
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/workspaces/$(id)) && request.resource.data.revision == 1)
          || (resource.data.ownerUid == request.auth.uid && request.resource.data.revision == resource.data.revision + 1));
      allow delete: if false;
    }
    match /classes/{classId} {
      allow get: if teacher() && (!exists(/databases/$(database)/documents/classes/$(classId)) || resource.data.ownerUid == request.auth.uid);
      allow list: if teacher() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if teacher()
        && request.resource.data.keys().hasOnly(['ownerUid', 'workspaceId', 'archived', 'data', 'roster'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.workspaceId is string
        && request.resource.data.archived is bool
        && request.resource.data.data is map && request.resource.data.roster is map
        && workspaceAdvanced(request.resource.data.workspaceId)
        && (!exists(/databases/$(database)/documents/classes/$(classId))
          || (resource.data.ownerUid == request.auth.uid && request.resource.data.workspaceId == resource.data.workspaceId));
      allow delete: if false;
      match /meetings/{meetingId} {
        allow get: if (teacher() && !exists(/databases/$(database)/documents/classes/$(classId)/meetings/$(meetingId))) || ownsClass(classId);
        allow list: if ownsClass(classId);
        allow create: if teacher()
          && getAfter(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid
          && workspaceAdvanced(getAfter(/databases/$(database)/documents/classes/$(classId)).data.workspaceId)
          && validMeeting(request.resource.data, meetingId)
          && (request.resource.data.state in ['upcoming', 'closed']
            || (request.resource.data.state == 'active' && request.time >= request.resource.data.dayStart && request.time < request.resource.data.dayEnd));
        allow update: if ownsClass(classId)
          && workspaceAdvanced(get(/databases/$(database)/documents/classes/$(classId)).data.workspaceId)
          && validMeeting(request.resource.data, meetingId)
          && ((resource.data.state == 'closed' && correction(request.resource.data))
            || (resource.data.state == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'records', 'auditEvents'])
              && request.resource.data.state in ['active', 'closed'])
            || (resource.data.state == 'upcoming'
              && (request.resource.data.state == 'upcoming'
                || (request.resource.data.state == 'active' && request.time >= resource.data.dayStart && request.time < resource.data.dayEnd)
                || (request.resource.data.state == 'closed' && request.time >= resource.data.dayEnd))));
        allow delete: if false;
      }
    }
    match /attendanceSessions/{sessionId} {
      function active(d) {
        let meeting = get(/databases/$(database)/documents/classes/$(d.classId)/meetings/$(d.meetingId)).data;
        return meeting.state == 'active' && request.time >= meeting.dayStart && request.time < meeting.dayEnd;
      }
      function valid(d) {
        return d.keys().hasOnly(['ownerUid', 'classId', 'localClassId', 'meetingId', 'label', 'receiving', 'expiresAt', 'createdAt', 'updatedAt'])
          && d.ownerUid == request.auth.uid && d.classId is string
          && d.localClassId is string && d.meetingId is string && d.label is string
          && d.receiving is bool && d.expiresAt is timestamp && d.createdAt is timestamp
          && d.updatedAt == request.time;
      }
      allow get: if googleUser();
      allow list: if teacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if valid(request.resource.data) && ownsClass(request.resource.data.classId)
        && active(request.resource.data) && request.resource.data.createdAt == request.time
        && request.resource.data.receiving == true && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'm');
      allow update: if valid(request.resource.data) && ownsClass(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiving', 'expiresAt', 'updatedAt'])
        && (request.resource.data.receiving == false
          || (active(resource.data) && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt <= request.time + duration.value(2, 'm')));
      allow delete: if false;
      match /checkIns/{uid} {
        function session() { return get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data; }
        allow get: if googleUser() && (uid == request.auth.uid || ownsClass(session().classId));
        allow list: if ownsClass(session().classId);
        allow create: if googleUser() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'email', 'at'])
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.at == request.time
          && session().receiving == true && request.time < session().expiresAt
          && active(session()) && rosterMember(session().classId);
        allow update, delete: if false;
      }
    }
    match /attendanceRequests/{id} {
      function validRequest(d) {
        let session = get(/databases/$(database)/documents/attendanceSessions/$(d.sessionId)).data;
        let course = get(/databases/$(database)/documents/classes/$(d.classId)).data;
        let meeting = get(/databases/$(database)/documents/classes/$(d.classId)/meetings/$(d.meetingId)).data;
        return d.keys().hasOnly(['uid', 'email', 'ownerUid', 'classId', 'meetingId', 'sessionId', 'requestedStatus', 'reason', 'state', 'createdAt'])
          && d.uid == request.auth.uid && d.email == request.auth.token.email.lower()
          && d.sessionId is string && id == d.classId + '_' + d.meetingId + '_' + request.auth.uid
          && d.classId == session.classId && d.meetingId == session.meetingId
          && d.ownerUid == session.ownerUid && d.ownerUid == course.ownerUid
          && rosterMember(d.classId) && meeting.state == 'closed'
          && d.requestedStatus in ['P', 'A']
          && d.requestedStatus != meeting.records[course.roster[d.email]].status
          && d.reason is string && d.reason.size() <= 1000 && d.reason.matches('.*\\S.*')
          && d.state == 'pending' && d.createdAt == request.time;
      }
      function approved(d) {
        let course = get(/databases/$(database)/documents/classes/$(d.classId)).data;
        let meeting = getAfter(/databases/$(database)/documents/classes/$(d.classId)/meetings/$(d.meetingId)).data;
        let before = get(/databases/$(database)/documents/classes/$(d.classId)/meetings/$(d.meetingId)).data;
        let audit = meeting.auditEvents[meeting.auditEvents.size() - 1];
        return course.archived == false && d.email in course.roster
          && meeting.state == 'closed'
          && workspaceAdvanced(course.workspaceId)
          && meeting.auditEvents.size() == before.auditEvents.size() + 1
          && audit.id == id && audit.reason == d.decisionReason
          && audit.rollNumber == course.roster[d.email]
          && audit.newValue == d.requestedStatus
          && meeting.records[course.roster[d.email]].status == d.requestedStatus;
      }
      allow get: if googleUser() && (!exists(/databases/$(database)/documents/attendanceRequests/$(id))
        || resource.data.uid == request.auth.uid || (teacher() && resource.data.ownerUid == request.auth.uid));
      allow list: if googleUser() && (resource.data.uid == request.auth.uid || (teacher() && resource.data.ownerUid == request.auth.uid));
      allow create: if googleUser() && validRequest(request.resource.data);
      allow update: if ownsClass(resource.data.classId) && resource.data.state == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'decisionReason', 'reviewerUid', 'decidedAt'])
        && request.resource.data.state in ['approved', 'rejected']
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decisionReason is string
        && request.resource.data.decisionReason.size() <= 1000
        && request.resource.data.decisionReason.matches('.*\\S.*')
        && (request.resource.data.state == 'rejected' || approved(request.resource.data));
      allow delete: if false;
    }
    match /announcements/{id} {
      allow read: if googleUser() && (resource.data.recipientUid == request.auth.uid
        || resource.data.ownerUid == request.auth.uid
        || ('recipientEmail' in resource.data && resource.data.recipientEmail == request.auth.token.email.lower()));
      allow create: if teacher()
        && request.resource.data.keys().hasOnly(['ownerUid', 'recipientUid', 'recipientEmail', 'title', 'body', 'at', 'classId', 'meetingId'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
        && request.resource.data.meetingId is string
        && (request.resource.data.meetingId == '' || exists(/databases/$(database)/documents/classes/$(request.resource.data.classId)/meetings/$(request.resource.data.meetingId)))
        && (!('recipientEmail' in request.resource.data)
          || (request.resource.data.recipientEmail is string
            && (request.resource.data.recipientEmail == ''
              || request.resource.data.recipientEmail in get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.roster)))
        && request.resource.data.at == request.time
        && ownsClass(request.resource.data.classId);
      allow update, delete: if false;
    }
    match /reportMetadata/{id} {
      allow get: if teacher() && (!exists(/databases/$(database)/documents/reportMetadata/$(id)) || resource.data.ownerUid == request.auth.uid);
      allow list: if teacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if teacher()
        && request.resource.data.keys().hasOnly(['ownerUid', 'classId', 'meetingId', 'fileName', 'format', 'bytes', 'at'])
        && request.resource.data.ownerUid == request.auth.uid && ownsClass(request.resource.data.classId)
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)/meetings/$(request.resource.data.meetingId)).data.state == 'closed'
        && request.resource.data.fileName is string && request.resource.data.format in ['pdf', 'csv', 'json']
        && request.resource.data.bytes is int && request.resource.data.bytes > 0 && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
