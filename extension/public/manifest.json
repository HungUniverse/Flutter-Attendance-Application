{
  "manifest_version": 3,
  "name": "FAP Attendance Importer",
  "version": "1.0.0",
  "description": "Đọc JSON/CSV điểm danh, đối chiếu MSSV và nhập P/A lên trang FAP hoặc trang demo.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://fap.fpt.edu.vn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fap.fpt.edu.vn/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
